<common:GlassWindow x:Class="VelvetTools.Modules.Knowledge.KnowledgeWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:VelvetTools.Common"
                    xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                    Title="知识库" Width="860" Height="600" MinWidth="700" MinHeight="440"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="CanResizeWithGrip"
                    ShowInTaskbar="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：知识库列表 -->
        <Grid Grid.Column="0" Margin="16,16,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="NewBaseBtn" Grid.Row="0" Content="＋  新建知识库" Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Stretch" Padding="0,9" Margin="0,0,0,10" Click="OnNewBaseClick"/>

            <ListBox x:Name="BaseList" Grid.Row="1" Style="{StaticResource GlassListBox}"
                     SelectionChanged="OnBaseSelected"/>

            <TextBlock Grid.Row="2" Style="{StaticResource SubtleText}" Margin="4,10,0,0" TextWrapping="Wrap"
                       Text="右键可重命名或删除知识库"/>
        </Grid>

        <!-- 右：库内容 -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragArea" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="BaseTitle" Text="知识库" Style="{StaticResource TitleText}"/>
                    <TextBlock x:Name="BaseSubtitle" Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Click="OnCloseClick" ToolTip="关闭">
                    <fi:FluentIcon Icon="Dismiss" FontSize="14"/>
                </Button>
            </Grid>

            <!-- 嵌入服务商 / 模型 + 索引操作 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="服务商" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
                    <ComboBox x:Name="EmbedProviderBox" Grid.Column="1" Style="{StaticResource GlassComboBox}"
                              Margin="10,0,12,0" SelectionChanged="OnEmbedProviderChanged"/>
                    <TextBlock Grid.Column="2" Text="模型" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
                    <ComboBox x:Name="EmbedModelBox" Grid.Column="3" Style="{StaticResource GlassComboBox}"
                              IsEditable="True" Margin="10,0,0,0"
                              DropDownOpened="OnEmbedDropDownOpened"/>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,11,0,0">
                        <Button x:Name="CancelImportBtn" Content="取消" Style="{StaticResource GlassButton}"
                                Visibility="Collapsed" Click="OnCancelOperationClick"/>
                        <Button x:Name="RebuildBtn" Content="重建索引" Style="{StaticResource GlassButton}"
                                Margin="8,0,0,0" Click="OnRebuildIndexClick"/>
                        <Button x:Name="TestBtn" Content="试检索" Style="{StaticResource GlassButton}"
                                Margin="8,0,0,0" Click="OnTestSearchClick"/>
                        <Button x:Name="AddDocBtn" Content="添加文档" Style="{StaticResource AccentButton}"
                                Margin="8,0,0,0" Click="OnAddDocumentClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 文档列表 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,6">
                <Grid>
                    <ListBox x:Name="DocList" Style="{StaticResource GlassListBox}"/>
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="380" IsHitTestVisible="False">
                        <fi:FluentIcon Icon="BookOpen" FontSize="28"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle" Text="还没有文档" Style="{StaticResource BodyText}" Opacity="0.8"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="EmptyDesc" Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,8,0,0"
                                   Text="添加 PDF / Word / Excel / 文本 等文档后，对话时开启「知识库」即可基于它们作答"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="4,10,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource SubtleText}" VerticalAlignment="Center"/>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" Height="3" Margin="12,0,0,0"
                             VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>
</common:GlassWindow>
