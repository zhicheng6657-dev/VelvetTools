<common:GlassWindow x:Class="VelvetTools.Modules.Clipboard.ClipboardWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:VelvetTools.Common"
                    xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                    Title="剪贴板历史" Width="420" Height="560"
                    WindowStartupLocation="CenterScreen"
                    Topmost="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="剪贴板历史" Style="{StaticResource TitleText}"/>
            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                    ToolTip="清空（保留置顶）" Click="OnClearClick">
                <fi:FluentIcon Icon="Delete" FontSize="15"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource GlassTextBox}"
                     TextChanged="OnSearchChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <ComboBox x:Name="FilterBox" Style="{StaticResource GlassComboBox}" Width="86"
                          SelectionChanged="OnSearchChanged">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <ComboBoxItem Content="文本"/>
                    <ComboBoxItem Content="图片"/>
                    <ComboBoxItem Content="文件"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource GlassListBox}"
                 MouseDoubleClick="OnItemDoubleClick" KeyDown="OnListKeyDown"/>

        <TextBlock Grid.Row="3" Margin="4,8,0,0" Style="{StaticResource SubtleText}"
                   Text="双击/Enter 粘贴 · Ctrl+C 仅复制 · Delete 删除 · 右键更多"/>
    </Grid>
</common:GlassWindow>
