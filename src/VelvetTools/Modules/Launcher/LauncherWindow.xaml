<common:GlassWindow x:Class="VelvetTools.Modules.Launcher.LauncherWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:VelvetTools.Common"
                    xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                    Title="Velvet Tools 启动器" Width="640" SizeToContent="Height"
                    WindowStartupLocation="Manual" Topmost="True">
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <fi:FluentIcon Icon="Search" FontSize="18" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="QueryBox" Grid.Column="1" Style="{StaticResource GlassTextBox}"
                     FontSize="18" Padding="12,10" Margin="8,0,0,0"
                     Background="Transparent" BorderThickness="0"
                     TextChanged="OnQueryChanged"/>
        </Grid>

        <ListBox x:Name="List" Style="{StaticResource GlassListBox}" Margin="0,10,0,0"
                 MaxHeight="420" Visibility="Collapsed"
                 MouseUp="OnListMouseUp"/>

        <TextBlock x:Name="HintText" Margin="6,10,0,0" Style="{StaticResource SubtleText}"
                   Text="输入应用名搜索 · Enter 打开 · Ctrl+Enter 管理员运行 · Esc 关闭"/>
    </StackPanel>
</common:GlassWindow>
