<common:GlassWindow x:Class="VelvetTools.Modules.Dashboard.DashboardWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:VelvetTools.Common"
                    xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                    Title="VelvetTools" Width="384" SizeToContent="Height"
                    WindowStartupLocation="Manual" Topmost="True">
    <StackPanel Margin="14">

        <!-- 头部 -->
        <Grid Margin="4,2,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource LogoPlateDarkImage}" Width="26" Height="26" VerticalAlignment="Center"/>
                <TextBlock Text="Velvet Tools" Style="{StaticResource TitleText}" FontSize="17"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="工具箱" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="7,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                    ToolTip="设置" Click="OnSettingsClick">
                <fi:FluentIcon Icon="Settings" FontSize="15"/>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                    ToolTip="退出 Velvet Tools" Click="OnExitClick">
                <fi:FluentIcon Icon="Power" FontSize="15"/>
            </Button>
        </Grid>

        <!-- 系统状态 -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <fi:FluentIcon Icon="ArrowDownload" FontSize="13"
                                       Foreground="{DynamicResource AccentLightBrush}"/>
                        <TextBlock x:Name="DownText" Text="-- KB/s" Style="{StaticResource BodyText}"
                                   FontFamily="Cascadia Code, Consolas" Margin="7,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <fi:FluentIcon Icon="ArrowUpload" FontSize="13"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="UpText" Text="-- KB/s" Style="{StaticResource BodyText}"
                                   FontFamily="Cascadia Code, Consolas" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="CpuText" Text="CPU --%" Style="{StaticResource BodyText}"
                               FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="0,12,0,0">
                    <Grid Margin="0,0,0,5">
                        <TextBlock x:Name="MemLabel" Text="内存 --%" Style="{StaticResource SubtleText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="MemBar" Style="{StaticResource GlassProgressBar}" Maximum="100"/>
                </StackPanel>

                <!-- 温度：仅显示安全公开接口或用户已运行监控工具提供的只读 WMI 数据 -->
                <Grid x:Name="TempRow" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="CpuTempCard">
                        <TextBlock x:Name="CpuTempLabel" Text="CPU" Style="{StaticResource SubtleText}" FontSize="11"/>
                        <TextBlock x:Name="CpuTempText" Text="--°C" Style="{StaticResource BodyText}"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="GpuTempCard" Grid.Column="1">
                        <TextBlock x:Name="GpuTempLabel" Text="GPU" Style="{StaticResource SubtleText}" FontSize="11"/>
                        <TextBlock x:Name="GpuTempText" Text="--°C" Style="{StaticResource BodyText}"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="DiskTempCard" Grid.Column="2">
                        <TextBlock x:Name="DiskTempLabel" Text="硬盘" Style="{StaticResource SubtleText}" FontSize="11"/>
                        <TextBlock x:Name="DiskTempText" Text="--°C" Style="{StaticResource BodyText}"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 亮度 -->
        <Border x:Name="BrightnessCard" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <fi:FluentIcon Icon="WeatherSunny" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="亮度" Style="{StaticResource SubtleText}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="LinkCheck" Content="同步" Style="{StaticResource GlassCheckBox}"
                              FontSize="12" HorizontalAlignment="Right"
                              Checked="OnLinkChanged" Unchecked="OnLinkChanged"/>
                </Grid>
                <ItemsControl x:Name="MonitorList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SubtleText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Style="{StaticResource GlassSlider}"
                                        Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                        Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0}%}"
                                           Style="{StaticResource SubtleText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoMonitorText" Text="未检测到可调亮度的显示器（显示器需开启 DDC/CI）"
                           Style="{StaticResource SubtleText}" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- 音量 -->
        <Border x:Name="VolumeCard" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteBtn" Style="{StaticResource IconButton}"
                        Click="OnMuteClick" ToolTip="静音/取消静音">
                    <fi:FluentIcon Icon="Speaker2" FontSize="15"/>
                </Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource GlassSlider}"
                        Minimum="0" Maximum="100" Margin="8,0,0,0" IsMoveToPointEnabled="True"
                        ValueChanged="OnVolumeChanged"/>
                <TextBlock x:Name="VolumeText" Grid.Column="2" Style="{StaticResource SubtleText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 快捷工具 -->
        <Border Style="{StaticResource Card}" Padding="8">
            <UniformGrid Columns="4" x:Name="ToolGrid"/>
        </Border>

    </StackPanel>
</common:GlassWindow>
