<common:GlassWindow x:Class="VelvetTools.Settings.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:VelvetTools.Common"
                    xmlns:fi="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                    Title="Velvet Tools 设置" Width="780" Height="600" MinWidth="680" MinHeight="480"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="CanResizeWithGrip"
                    ShowInTaskbar="True">
    <common:GlassWindow.Resources>
        <!-- 设置行：标题 + 描述 + 右侧控件 -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="NavItemPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="4,3"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="fi:FluentIcon">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="11,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </common:GlassWindow.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragArea" Margin="2,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource LogoPlateDarkImage}" Width="22" Height="22" VerticalAlignment="Center"/>
                <TextBlock Text="设置" Style="{StaticResource TitleText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                    Click="OnCloseClick" ToolTip="关闭">
                <fi:FluentIcon Icon="Dismiss" FontSize="14"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <ListBox x:Name="Nav" Style="{StaticResource GlassListBox}" SelectionChanged="OnNavChanged">
                <ListBoxItem IsSelected="True">
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Settings" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="通用" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Keyboard" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="快捷键" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Screenshot" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="截图" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Translate" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="OCR 与翻译" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Clipboard" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="剪贴板" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Bot" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="AI 对话" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Search" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="文件搜索" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Style="{StaticResource NavItemPanel}">
                        <fi:FluentIcon Icon="Info" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="关于" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- 右侧面板 -->
            <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- ================= 通用 ================= -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="外观" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="主题" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="切换立即生效；浅色为白色磨玻璃" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="10"
                                            Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeSystemRadio" Style="{StaticResource SegmentRadio}"
                                                         Content="跟随系统" GroupName="theme" Checked="OnThemeChecked"/>
                                            <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource SegmentRadio}"
                                                         Content="深色" GroupName="theme" Checked="OnThemeChecked"/>
                                            <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource SegmentRadio}"
                                                         Content="浅色" GroupName="theme" Checked="OnThemeChecked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="基础" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="16,6">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="登录系统时自动启动应用" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AutoStartCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="任务栏信息栏" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="在任务栏“显示隐藏图标”箭头左侧内嵌显示实时数据" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="TaskbarBarCheck" Style="{StaticResource Switch}"
                                              Click="OnTaskbarOptionChanged"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <StackPanel x:Name="BarItemsSection">
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="信息栏内容" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="逐项勾选要监控的数据；全部关闭则只保留托盘图标" Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="BarItemsRow" Margin="0,4,0,10">
                                        <WrapPanel HorizontalAlignment="Right">
                                            <CheckBox x:Name="BarNetCheck" Content="网速" Style="{StaticResource GlassCheckBox}"
                                                      Margin="0,0,14,6" Click="OnTaskbarOptionChanged"/>
                                            <CheckBox x:Name="BarCpuCheck" Content="CPU 占用" Style="{StaticResource GlassCheckBox}"
                                                      Margin="0,0,14,6" Click="OnTaskbarOptionChanged"/>
                                            <CheckBox x:Name="BarMemCheck" Content="内存占用" Style="{StaticResource GlassCheckBox}"
                                                      Margin="0,0,14,6" Click="OnTaskbarOptionChanged"/>
                                            <CheckBox x:Name="BarCpuTempCheck" Content="CPU 温度" Style="{StaticResource GlassCheckBox}"
                                                      Margin="0,0,14,6" Click="OnTempCheckClick"
                                                      ToolTip="优先读取 Windows/厂商公开接口；兼容已运行监控软件的只读 WMI，不捆绑内核驱动"/>
                                            <CheckBox x:Name="BarGpuTempCheck" Content="显卡温度" Style="{StaticResource GlassCheckBox}"
                                                      Margin="0,0,14,6" Click="OnTempCheckClick"/>
                                            <CheckBox x:Name="BarDiskTempCheck" Content="硬盘温度" Style="{StaticResource GlassCheckBox}"
                                                      Margin="0,0,0,6" Click="OnTempCheckClick"
                                                      ToolTip="通过 Windows 存储接口只读查询 NVMe/SATA 健康数据，不写入硬盘"/>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="桌面悬浮窗" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="可拖动的小胶囊，显示网速与内存" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="FloatCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="权限" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}" Padding="16,6">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="始终以最高权限运行" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="计划任务方式，配置一次后启动不再弹 UAC"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AlwaysAdminCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border x:Name="ElevateDivider" Style="{StaticResource Hairline}"/>
                                <Grid x:Name="ElevateRow" Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminStateText" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="首次开启上面的开关后点“保存”，会自动请求一次管理员授权；也可先以管理员身份重启" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ElevateNowBtn" Content="以管理员身份重启"
                                            Style="{StaticResource GlassButton}" VerticalAlignment="Center" Click="OnElevateClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 快捷键 ================= -->
                    <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                        <TextBlock Text="全局快捷键" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="HotkeyPanel"/>
                        </Border>
                        <TextBlock Style="{StaticResource SubtleText}" Margin="4,10,0,0"
                                   Text="点击快捷键框后直接按下新组合；Esc 取消，Backspace 清除。冲突组合不会覆盖原快捷键，保存后立即生效。"/>
                    </StackPanel>

                    <!-- ================= 截图 ================= -->
                    <StackPanel x:Name="PageScreenshot" Visibility="Collapsed">
                        <TextBlock Text="行为" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}" Padding="16,6">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="自动复制到剪贴板" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="截图完成后立即写入剪贴板" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ShotCopyCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="自动保存 PNG 文件" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="每次截图都在保存目录留档" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ShotSaveCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="保存目录" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ShotDirBox" Style="{StaticResource GlassTextBox}"/>
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource GlassButton}"
                                        Margin="8,0,0,0" Click="OnBrowseDirClick"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ================= OCR 与翻译 ================= -->
                    <StackPanel x:Name="PageApi" Visibility="Collapsed">
                        <TextBlock Text="OCR 引擎" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ComboBox x:Name="OcrProviderBox" Style="{StaticResource GlassComboBox}" Width="260"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Windows 本地 OCR（离线，免费）"/>
                                    <ComboBoxItem Content="OpenAI 兼容视觉接口"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="2,8,0,0"
                                           Text="本地 OCR 使用系统语言包；无法识别中文时请在 Windows 设置为中文添加“光学字符识别”，或切换为接口模式。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="OpenAI 兼容接口（OCR 与翻译共用）" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Base URL" Style="{StaticResource RowDesc}" Margin="2,0,0,5"/>
                                <TextBox x:Name="OpenAiUrlBox" Style="{StaticResource GlassTextBox}"/>
                                <TextBlock Text="API Key" Style="{StaticResource RowDesc}" Margin="2,10,0,5"/>
                                <TextBox x:Name="OpenAiKeyBox" Style="{StaticResource GlassTextBox}"/>
                                <TextBlock Text="模型（OCR 需支持视觉，如 gpt-4o-mini）" Style="{StaticResource RowDesc}" Margin="2,10,0,5"/>
                                <TextBox x:Name="OpenAiModelBox" Style="{StaticResource GlassTextBox}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="翻译服务" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="TransProviderBox" Style="{StaticResource GlassComboBox}" Width="180">
                                        <ComboBoxItem Content="OpenAI 兼容接口"/>
                                        <ComboBoxItem Content="DeepL"/>
                                        <ComboBoxItem Content="百度翻译"/>
                                    </ComboBox>
                                    <TextBlock Text="目标语言" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <ComboBox x:Name="TransLangBox" Style="{StaticResource GlassComboBox}" Width="110"/>
                                </StackPanel>

                                <TextBlock Text="DeepL API Key" Style="{StaticResource RowDesc}" Margin="2,12,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DeepLKeyBox" Style="{StaticResource GlassTextBox}"/>
                                    <CheckBox x:Name="DeepLFreeCheck" Grid.Column="1" Content="Free 接口"
                                              Style="{StaticResource GlassCheckBox}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="百度翻译 APP ID / 密钥" Style="{StaticResource RowDesc}" Margin="2,12,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BaiduIdBox" Style="{StaticResource GlassTextBox}"/>
                                    <TextBox x:Name="BaiduKeyBox" Grid.Column="2" Style="{StaticResource GlassTextBox}"/>
                                </Grid>

                                <TextBlock Style="{StaticResource RowDesc}" Margin="2,12,0,0"
                                           Text="所有密钥仅保存在本机 %AppData%\VelvetTools\settings.json（明文），不会上传。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 剪贴板 ================= -->
                    <StackPanel x:Name="PageClipboard" Visibility="Collapsed">
                        <TextBlock Text="剪贴板历史" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}" Padding="16,6">
                            <StackPanel>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="启用剪贴板历史" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="历史仅保存在本机；密码管理器复制的内容不会记录" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ClipEnableCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="记录图片" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="会占用更多磁盘空间" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ClipImageCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="选中后自动粘贴" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="双击/回车条目后自动回贴到原窗口" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ClipPasteCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="最大保留条数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="超出后自动淘汰最旧的未置顶条目" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="ClipMaxBox" Style="{StaticResource GlassTextBox}"
                                             Width="90" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= AI 对话 ================= -->
                    <StackPanel x:Name="PageChat" Visibility="Collapsed">
                        <TextBlock Text="服务商" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ChatProviderBox" Style="{StaticResource GlassComboBox}"
                                              SelectionChanged="OnChatProviderChanged"/>
                                    <Button Grid.Column="1" Content="新增" Style="{StaticResource GlassButton}"
                                            Margin="8,0,0,0" Click="OnChatAddProviderClick"/>
                                    <Button Grid.Column="2" x:Name="ChatDeleteBtn" Content="删除" Style="{StaticResource GlassButton}"
                                            Margin="8,0,0,0" Click="OnChatDeleteProviderClick"/>
                                </Grid>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="2,8,0,0"
                                           Text="内置千问 / Kimi / 豆包 / DeepSeek / 智谱 / 硅基流动 / OpenAI 兼容；也可新增任意 OpenAI 兼容服务。"/>

                                <TextBlock Text="Base URL" Style="{StaticResource RowDesc}" Margin="2,14,0,5"/>
                                <TextBox x:Name="ChatUrlBox" Style="{StaticResource GlassTextBox}"/>

                                <TextBlock Text="API Key" Style="{StaticResource RowDesc}" Margin="2,10,0,5"/>
                                <Grid>
                                    <PasswordBox x:Name="ChatKeyBox"
                                                 Style="{StaticResource GlassPasswordBox}"
                                                 Padding="9,7,42,7"/>
                                    <TextBox x:Name="ChatKeyRevealBox"
                                             Style="{StaticResource GlassTextBox}"
                                             Padding="9,7,42,7"
                                             IsReadOnly="True"
                                             Visibility="Collapsed"/>
                                    <ToggleButton x:Name="ChatKeyRevealToggle"
                                                  Style="{StaticResource ToolToggle}"
                                                  Width="32"
                                                  Height="32"
                                                  Margin="0,2,4,2"
                                                  HorizontalAlignment="Right"
                                                  ToolTip="按住查看密钥"
                                                  PreviewMouseLeftButtonDown="OnChatKeyRevealDown"
                                                  PreviewMouseLeftButtonUp="OnChatKeyRevealUp"
                                                  MouseLeave="OnChatKeyRevealLeave">
                                        <fi:FluentIcon Icon="Eye" FontSize="14"/>
                                    </ToggleButton>
                                </Grid>

                                <Grid Margin="0,10,0,5">
                                    <TextBlock x:Name="ChatModelHint" Text="模型" Style="{StaticResource RowDesc}"
                                               Margin="2,0,0,0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="ChatFetchBtn" Content="获取模型" Style="{StaticResource GlassButton}"
                                                Padding="12,6" FontSize="12" Click="OnChatFetchModelsClick"
                                                ToolTip="调用服务商的 /models 接口拉取当前密钥可用的模型"/>
                                        <Button x:Name="ChatTestBtn" Content="检查密钥" Style="{StaticResource GlassButton}"
                                                Padding="12,6" FontSize="12" Margin="8,0,0,0" Click="OnChatTestClick"/>
                                    </StackPanel>
                                </Grid>
                                <ComboBox x:Name="ChatModelBox" Style="{StaticResource GlassComboBox}"
                                          IsEditable="True" MinHeight="40"
                                          ToolTip="可从列表选择，也可直接输入服务商提供的模型 ID"/>
                                <TextBlock x:Name="ChatTestResult" Style="{StaticResource RowDesc}" Margin="2,8,0,0"/>
                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="9"
                                        Padding="10,7" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ChatProviderStatusDot" Width="8" Height="8"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ChatProviderStatusText" Style="{StaticResource RowDesc}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="对话参数" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="系统提示词" Style="{StaticResource RowDesc}" Margin="2,0,0,5"/>
                                <TextBox x:Name="ChatSystemBox" Style="{StaticResource GlassTextBox}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64"
                                         VerticalContentAlignment="Top"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="流式输出" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="边生成边显示，体验更好" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChatStreamCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}" Margin="0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="随机性 (temperature)" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="0 更稳定，1 更发散" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="ChatTempSlider" Style="{StaticResource GlassSlider}" Width="150"
                                                Minimum="0" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="OnChatTempChanged"/>
                                        <TextBlock x:Name="ChatTempText" Style="{StaticResource RowDesc}" Width="34"
                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource Hairline}" Margin="0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="携带历史条数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="每次请求带上最近 N 条消息；填 0 表示不限制" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="ChatContextBox" Style="{StaticResource GlassTextBox}"
                                             Width="90" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="联网搜索" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="搜索来源" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="DuckDuckGo 无需密钥、开箱即用；Tavily / Bing 结果更稳但要自备密钥"
                                                   Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="WebProviderBox" Style="{StaticResource GlassComboBox}"
                                              Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="DuckDuckGo"/>
                                        <ComboBoxItem Content="Tavily"/>
                                        <ComboBoxItem Content="Bing"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource Hairline}" Margin="0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="默认开启联网" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="打开对话窗时自动启用（也可在对话窗随时开关）" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="WebDefaultCheck" Style="{StaticResource Switch}"/>
                                </Grid>
                                <TextBlock Text="Tavily API Key" Style="{StaticResource RowDesc}" Margin="2,12,0,5"/>
                                <TextBox x:Name="TavilyKeyBox" Style="{StaticResource GlassTextBox}"/>
                                <TextBlock Text="Bing 搜索密钥（Azure）" Style="{StaticResource RowDesc}" Margin="2,10,0,5"/>
                                <TextBox x:Name="BingKeyBox" Style="{StaticResource GlassTextBox}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="返回结果数" Style="{StaticResource RowDesc}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="WebMaxBox" Style="{StaticResource GlassTextBox}" Width="70" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="文档解析" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                       Text="对话窗点击 ＋ → 选择文档，即可解析 PDF / Word / Excel / PowerPoint 以及文本、代码文件，提取出的文字会随本轮提问一起发送。单个文件最多取 6 万字，超出部分自动截断。扫描件请改用截图 OCR。"/>
                        </Border>

                        <TextBlock Text="知识库" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap"
                                           Text="把文档一次性灌进知识库（单文件最多索引 100 万字），之后提问会用向量语义 + 关键词混合检索相关片段，比每轮都带整份文档省 token。服务商需支持 /embeddings；更换服务商或模型可在管理页安全重建，不必重新选择原文件。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="打开知识库管理" Style="{StaticResource AccentButton}"
                                            Padding="16,7" Click="OnOpenKnowledgeClick"/>
                                </StackPanel>
                                <Border Style="{StaticResource Hairline}" Margin="0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="检索片段数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="每次提问最多注入几段原文，一般 3–8 段" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="KbTopKBox" Style="{StaticResource GlassTextBox}"
                                             Width="90" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Style="{StaticResource Hairline}" Margin="0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="相似度下限" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="0–1，语义分低于阈值时通常丢弃（高关键词覆盖可补回）；调高更精准、调低召回更多" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="KbMinScoreBox" Style="{StaticResource GlassTextBox}"
                                             Width="90" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource RowDesc}" Margin="4,14,0,0" TextWrapping="Wrap"
                                   Text="密钥仅保存在本机 settings.json，不会上传；应用只与你所配置的服务商通信。"/>
                    </StackPanel>

                    <!-- ================= 文件搜索 ================= -->
                    <StackPanel x:Name="PageSearch" Visibility="Collapsed">
                        <TextBlock Text="Everything 集成" Style="{StaticResource SectionCaption}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="EvStatusDot" Width="9" Height="9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EvStatusText" Style="{StaticResource RowTitle}" Margin="9,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Everything 已随本应用一起打包，首次搜索时自动在后台启动，无需你安装任何东西。若你的电脑上已经装了 Everything，则直接复用你那一份的索引。Everything 由 voidtools 开发并以 MIT 许可分发，随附的 Everything-License.txt 为其许可原文。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="检测状态" Style="{StaticResource GlassButton}" Click="OnEverythingCheckClick"/>
                                    <Button Content="voidtools 官网" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="OnEverythingDownloadClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="搜索选项" Style="{StaticResource SectionCaption}" Margin="4,16,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="最大结果数" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="过大会拖慢渲染，建议 100–500" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" x:Name="SearchMaxBox" Style="{StaticResource GlassTextBox}"
                                         Width="90" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ================= 关于 ================= -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource LogoPlateDarkImage}" Width="46" Height="46"/>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Velvet Tools" Style="{StaticResource TitleText}" FontSize="18"/>
                                        <TextBlock x:Name="VersionText" Style="{StaticResource SubtleText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0" TextWrapping="Wrap"
                                           Text="Velvet Tools 是一个常驻系统托盘的 Windows 工具箱。它把截图、OCR、翻译、文件搜索、剪贴板、快速启动和 AI 对话放在同一个轻量应用里，也能按需显示网速、系统状态和硬件温度。"/>
                                <TextBlock Style="{StaticResource RowDesc}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="设置、对话和知识库默认保存在本机；需要联网的功能只会连接你自己选择并配置的服务。"/>
                                <Border Style="{StaticResource Hairline}" Margin="0,16,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="作者" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="本项目采用 GPL-3.0-or-later 协议开源" Style="{StaticResource RowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Velvet" Style="{StaticResource GlassButton}"
                                            Click="OnOpenProjectClick" ToolTip="打开 Velvet Tools 项目主页"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="项目主页" Style="{StaticResource GlassButton}" Click="OnOpenProjectClick"/>
                                    <Button Content="打开数据目录" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="OnOpenDataDirClick"/>
                                    <Button Content="打开日志" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="OnOpenLogClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="SaveStatus" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="保存并应用" Style="{StaticResource AccentButton}" Padding="20,8" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</common:GlassWindow>
