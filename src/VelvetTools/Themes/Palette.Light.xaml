<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色调色板：Win11 任务管理器风（Mica 浅灰底 / 白卡片 / 灰交互 / 蓝点缀） ============ -->
    <Color x:Key="AccentColor">#0F6CBD</Color>
    <Color x:Key="AccentLightColor">#2E86D6</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#2E86D6"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26D97706"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26C42B1C"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5F66"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94979E"/>

    <!-- 白卡片 + 极浅描边（任务管理器卡片观感） -->
    <SolidColorBrush x:Key="CardBrush" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1A0F1420"/>

    <!-- 交互态用灰，不用蓝（Win11 惯例） -->
    <SolidColorBrush x:Key="ControlBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#0F0F1420"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#170F1420"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FBFCFE"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1F0F1420"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#120F1420"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#140F1420"/>
    <SolidColorBrush x:Key="TileBubbleBrush" Color="#170F6CBD"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF"/>
    <!-- 窗口底衬：Mica 浅灰白（Win11 任务管理器观感） -->
    <SolidColorBrush x:Key="WindowTintBrush" Color="#EAF4F6F9"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E86D6" Offset="0"/>
        <GradientStop Color="#0F6CBD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4D9AE0" Offset="0"/>
        <GradientStop Color="#1B78C9" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassButtonBrush" Color="#F5FFFFFF"/>
    <SolidColorBrush x:Key="GlassButtonHoverBrush" Color="#FDFDFD"/>

</ResourceDictionary>
